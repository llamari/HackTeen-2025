        "/users/forgot/password": {
            "put": {
                "tags": [
                    "Auth"
                ],
                "summary": "Solicita redefinição de senha",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "email"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string"
                                    }
                                },
                                "example": {
                                    "email": "usuario@exemplo.com"
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Código enviado com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
