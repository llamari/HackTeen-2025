    "paths": {
        "/users": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Lista todos os usuários",
                "description": "Retorna todos os usuários cadastrados.",
                "responses": {
                    "200": {
                        "description": "Lista de usuários retornada com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "id": {
                                                "type": "integer"
                                            },
                                            "email": {
                                                "type": "string"
                                            },
                                            "password": {
                                                "type": "string"
                                            },
                                            "code": {
                                                "type": "string"
                                            },
                                            "createdAt": {
                                                "type": "string",
                                                "format": "date-time"
                                            },
                                            "updatedAt": {
                                                "type": "string",
                                                "format": "date-time"
                                            }
                                        }
                                    }
                                },
                                "examples": {
                                    "success": {
                                        "value": [
                                            {
                                                "id": 1,
                                                "email": "usuario1@exemplo.com",
                                                "password": "senha1criptografada",
                                                "code": null,
                                                "createdAt": "2025-06-15T13:41:30.831Z",
                                                "updatedAt": "2025-06-15T13:41:30.831Z"
                                            },
                                            {
                                                "id": 2,
                                                "email": "usuario2@exemplo.com",
                                                "password": "senha2criptografada",
                                                "code": "1234",
                                                "createdAt": "2025-05-10T13:41:30.831Z",
                                                "updatedAt": "2025-05-15T13:41:30.831Z"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/users/signup": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Registra um novo usuário",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "email",
                                    "senha"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string"
                                    },
                                    "senha": {
                                        "type": "string"
                                    }
                                }
                            },
                            "example": {
                                "email": "usuario@exemplo.com",
                                "senha": "senhaSegura123"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Usuário criado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        },
                                        "success": {
                                            "type": "boolean"
                                        }
                                    }
                                },
                                "examples": {
                                    "success": {
                                        "value": {
                                            "message": "Usuário criado",
                                            "success": true
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Erro interno",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/users/signin": {
            "put": {
                "tags": [
                    "Auth"
                ],
                "summary": "Faz login de um usuário",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "email",
                                    "senha"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string"
                                    },
                                    "senha": {
                                        "type": "string"
                                    }
                                }
                            },
                            "example": {
                                "email": "usuario@exemplo.com",
                                "senha": "senhaSegura123"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login bem-sucedido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        },
                                        "token": {
                                            "type": "string"
                                        },
                                        "success": {
                                            "type": "boolean"
                                        }
                                    }
                                },
                                "examples": {
                                    "success": {
                                        "value": {
                                            "success": true,
                                            "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOjEsImV4cCI6MTYyODg3NzYwMX0.6kUJdxk_wfh7DdYhTqT8GVXXd04-K35UkK73D7h4ZPQ",
                                            "message": "Login realizado com sucesso"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Credenciais inválidas",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        },
                                        "success": {
                                            "value": false
                                        },
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "examples": {
                                    "invalidCredentials": {
                                        "value": {
                                            "message": "Erro de autenticação",
                                            "success": false,
                                            "error": "Usuário não encontrado"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/users/delete": {
            "delete": {
                "tags": [
                    "Auth"
                ],
                "summary": "Remove um usuário",
