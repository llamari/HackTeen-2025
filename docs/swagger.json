{
    "openapi": "3.0.3",
    "info": {
        "title": "IncluSound API",
        "version": "1.0.0",
        "description": "Documentação da API do projeto IncluSound"
    },
    "servers": [
        {
            "url": "http://localhost:5000",
            "description": "Servidor local para a utilização da API"
        }
    ],
    "tags": [
        {
            "name": "Users",
            "description": "Rotas de criação e autentificação de usuários"
        },
        {
            "name": "Text to Sound",
            "description": "Rotas de processamento de texto"
        },
        {
            "name": "Text to Braille",
            "description": "Rotas de conversão de texto para braille"
        }
    ],
    "paths": {
        "/users": {
            "get": {
                "tags": ["Users"],
                "summary": "Lista todos os usuários",
                "security": [{"bearerAuth": []}],
                "description": "Retorna todos os usuários cadastrados (requer autenticação).",
                "responses": {
                    "200": {
                        "description": "Lista de usuários retornada com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {"$ref": "#/components/schemas/User"}
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Token não fornecido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "example": {
                                    "message": "Token não fornecido"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Token inválido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                },
                                "example": {
                                    "message": "Token inválido"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/users/signup": {
            "post": {
                "tags": ["Users"],
                "summary": "Registra um novo usuário",
                "description": "Rota pública para registro de novos usuários.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/SignUpRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Usuário criado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SignUpResponse"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Usuário já existe",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/users/signin": {
            "put": {
                "tags": ["Users"],
                "summary": "Faz login de um usuário",
                "description": "Rota pública para autenticação de usuários.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/SignInRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login realizado com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SignInResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Credenciais inválidas",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Token inválido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/users/delete": {
            "delete": {
                "tags": ["Users"],
                "summary": "Remove um usuário",
                "security": [{"bearerAuth": []}],
                "description": "Remove um usuário do sistema (requer autenticação).",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/DeleteUserRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Usuário removido com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SuccessResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Token não fornecido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Token inválido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/users/forgot/password": {
            "put": {
                "tags": ["Users"],
                "summary": "Solicita redefinição de senha",
                "description": "Rota pública para solicitar redefinição de senha.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ForgotPasswordRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "E-mail enviado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SuccessResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/users/verify/code": {
            "put": {
                "tags": ["Users"],
                "summary": "Verifica código de redefinição",
                "description": "Rota pública para verificar código de redefinição de senha.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/VerifyCodeRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "Código válido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SuccessResponse"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Código inválido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/users/new/password": {
            "put": {
                "tags": ["Users"],
                "summary": "Redefine a senha",
                "security": [{"bearerAuth": []}],
                "description": "Redefine a senha do usuário (requer autenticação).",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/NewPasswordRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "Senha redefinida com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SuccessResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Token não fornecido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Token inválido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/tts": {
            "post": {
                "tags": ["Text to Sound"],
                "summary": "Converte texto em áudio",
                "security": [{"bearerAuth": []}],
                "description": "Converte texto em áudio (requer autenticação).",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/TTSRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Arquivo de áudio gerado com sucesso",
                        "content": {
                            "application/octet-stream": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Token não fornecido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Token inválido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/tts/summarize": {
            "post": {
                "tags": ["Text to Sound"],
                "summary": "Resume um texto",
                "security": [{"bearerAuth": []}],
                "description": "Resume um texto (requer autenticação).",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/SummarizeRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Resumo gerado com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SummarizeResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Token não fornecido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Token inválido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/tts/describeImage": {
            "post": {
                "tags": ["Text to Sound"],
                "summary": "Descreve uma imagem",
                "security": [{"bearerAuth": []}],
                "description": "Descreve uma imagem enviada (requer autenticação).",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/DescribeImageRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Descrição gerada com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/DescribeImageResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Token não fornecido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Token inválido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/tts/yourtexts": {
            "get": {
                "tags": ["Text to Sound"],
                "summary": "Lista textos do usuário",
                "security": [{"bearerAuth": []}],
                "description": "Lista todos os textos do usuário autenticado.",
                "responses": {
                    "200": {
                        "description": "Lista de textos retornada com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/UserText"
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Token não fornecido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Token inválido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/tts/textToBraille": {
            "post": {
                "tags": ["Text to Braille"],
                "summary": "Converte texto em Braille",
                "security": [{"bearerAuth": []}],
                "description": "Converte texto para Braille (requer autenticação).",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/TextToBrailleRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Texto convertido com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TextToBrailleResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Token não fornecido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Token inválido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/tts/brailleToText": {
            "post": {
                "tags": ["Text to Braille"],
                "summary": "Converte Braille em texto",
                "security": [{"bearerAuth": []}],
                "description": "Converte Braille para texto (requer autenticação).",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/BrailleToTextRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Braille convertido com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BrailleToTextResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Token não fornecido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Token inválido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/tts/brailleDisplay": {
            "post": {
                "tags": ["Text to Braille"],
                "summary": "Gera dados para display Braille",
                "security": [{"bearerAuth": []}],
                "description": "Gera dados para exibição em display Braille (requer autenticação).",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/BrailleDisplayRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Dados gerados com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BrailleDisplayResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Token não fornecido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Token inválido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT",
                "description": "Token JWT obtido no login. Deve ser incluído no cabeçalho Authorization como 'Bearer {token}'"
            }
        },
        "schemas": {
            "User": {
                "type": "object",
                "properties": {
                    "id": {"type": "integer"},
                    "email": {"type": "string"},
                    "password": {"type": "string"},
                    "code": {"type": "string"},
                    "createdAt": {"type": "string", "format": "date-time"},
                    "updatedAt": {"type": "string", "format": "date-time"}
                }
            },
            "SignUpRequest": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                    "email": {"type": "string", "format": "email"},
                    "password": {"type": "string", "minLength": 6}
                }
            },
            "SignUpResponse": {
                "type": "object",
                "properties": {
                    "message": {"type": "string"},
                    "id": {"type": "integer"},
                    "success": {"type": "boolean"}
                }
            },
            "SignInRequest": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                    "email": {"type": "string", "format": "email"},
                    "password": {"type": "string"}
                }
            },
            "SignInResponse": {
                "type": "object",
                "properties": {
                    "message": {"type": "string"},
                    "token": {"type": "string"},
                    "success": {"type": "boolean"}
                }
            },
            "DeleteUserRequest": {
                "type": "object",
                "required": ["email"],
                "properties": {
                    "email": {"type": "string", "format": "email"}
                }
            },
            "ForgotPasswordRequest": {
                "type": "object",
                "required": ["email"],
                "properties": {
                    "email": {"type": "string", "format": "email"}
                }
            },
            "VerifyCodeRequest": {
                "type": "object",
                "required": ["code", "email"],
                "properties": {
                    "code": {"type": "string"},
                    "email": {"type": "string", "format": "email"}
                }
            },
            "NewPasswordRequest": {
                "type": "object",
                "required": ["password", "email"],
                "properties": {
                    "password": {"type": "string"},
                    "email": {"type": "string", "format": "email"}
                }
            },
            "TTSRequest": {
                "type": "object",
                "required": ["text", "language"],
                "properties": {
                    "text": {"type": "string"},
                    "language": {"type": "string"}
                }
            },
            "SummarizeRequest": {
                "type": "object",
                "required": ["text"],
                "properties": {
                    "text": {"type": "string"}
                }
            },
            "SummarizeResponse": {
                "type": "object",
                "properties": {
                    "summary": {"type": "string"}
                }
            },
            "DescribeImageRequest": {
                "type": "object",
                "required": ["imageBase64"],
                "properties": {
                    "imageBase64": {"type": "string"}
                }
            },
            "DescribeImageResponse": {
                "type": "object",
                "properties": {
                    "description": {"type": "string"}
                }
            },
            "UserText": {
                "type": "object",
                "properties": {
                    "id": {"type": "integer"},
                    "content": {"type": "string"},
                    "user_id": {"type": "integer"},
                    "createdAt": {"type": "string", "format": "date-time"},
                    "updatedAt": {"type": "string", "format": "date-time"}
                }
            },
            "TextToBrailleRequest": {
                "type": "object",
                "required": ["text"],
                "properties": {
                    "text": {"type": "string"}
                }
            },
            "TextToBrailleResponse": {
                "type": "object",
                "properties": {
                    "message": {"type": "string"},
                    "text": {"type": "string"},
                    "id": {"type": "integer"}
                }
            },
            "BrailleToTextRequest": {
                "type": "object",
                "required": ["braille"],
                "properties": {
                    "braille": {"type": "string"}
                }
            },
            "BrailleToTextResponse": {
                "type": "object",
                "properties": {
                    "result": {"type": "string"}
                }
            },
            "BrailleDisplayRequest": {
                "type": "object",
                "required": ["text"],
                "properties": {
                    "text": {"type": "string"}
                }
            },
            "BrailleDisplayResponse": {
                "type": "object",
                "properties": {
                    "result": {"type": "string"}
                }
            },
            "SuccessResponse": {
                "type": "object",
                "properties": {
                    "message": {"type": "string"},
                    "success": {"type": "boolean"}
                }
            },
            "Error": {
                "type": "object",
                "properties": {
                    "message": {"type": "string"},
                    "error": {"type": "string"},
                    "success": {"type": "boolean"}
                }
            }
        },
        "responses": {
            "UnauthorizedError": {
                "description": "Token de autenticação ausente ou inválido",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        },
                        "examples": {
                            "noToken": {
                                "value": {
                                    "message": "Token não fornecido",
                                    "success": false
                                }
                            },
                            "invalidToken": {
                                "value": {
                                    "message": "Token inválido",
                                    "success": false
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}