                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "examples": {
                                    "invalidCredentials": {
                                        "value": {
                                            "message": "Token não fornecido"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "403": {
                    "description": "Token inválido",
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "message": {
                                        "type": "string"
                                    }
                                }
                            },
                            "examples": {
                                "invalidCredentials": {
                                    "value": {
                                        "message": "Token inválido"
                                    }
                                }
                            }
                        }
                    }
                },
                "500": {
                    "description": "Usuário não encontrado",
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "message": {
                                        "type": "string"
                                    }
                                }
                            },
                            "examples": {
                                "userNotFound": {
                                    "value": {
                                        "message": "Usuário não encontrado"
